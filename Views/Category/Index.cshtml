@model IEnumerable<ECommerce_Mvc.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<style>
    /* تنسيقات البطاقة الحاوية للجدول */
    .surface-card {
        background-color: var(--bg-surface, #161D2F);
        border: 1px solid var(--border-color, #2A3449);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    }

    /* إجبار الجدول على الشفافية ليتماشى مع الخلفية الداكنة */
    .custom-table {
        color: #E2E8F0 !important;
        margin-bottom: 0;
        background-color: transparent !important;
        --bs-table-bg: transparent !important;
    }

        .custom-table thead th {
            background-color: rgba(0, 0, 0, 0.25) !important; /* خلفية داكنة للرأس */
            color: #94A3B8 !important; /* لون رمادي فاتح ومقروء */
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
            padding: 1.2rem 1.5rem;
            border-bottom: 1px solid #2A3449 !important;
            font-weight: 600;
        }

        .custom-table tbody td {
            padding: 1.2rem 1.5rem;
            border-bottom: 1px solid #2A3449 !important;
            vertical-align: middle;
            color: #F8FAFC !important; /* لون أبيض ناصع للنصوص */
            background-color: transparent !important;
        }

        .custom-table tbody tr {
            background-color: transparent !important;
            transition: background-color 0.2s ease;
        }

            /* تأثير إضاءة خفيف جداً عند تمرير الماوس */
            .custom-table tbody tr:hover td {
                background-color: rgba(255, 255, 255, 0.05) !important;
            }

            .custom-table tbody tr:last-child td {
                border-bottom: none !important;
            }

    /* أزرار الإجراءات (Actions) */
    .btn-action {
        background-color: transparent;
        color: #94A3B8;
        border: 1px solid #2A3449;
        border-radius: 0.5rem;
        padding: 0.4rem 0.8rem;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

        .btn-action:hover {
            background-color: #2A3449;
            color: #E2E8F0;
        }

        .btn-action.edit:hover {
            color: #D4AF37;
            border-color: #D4AF37;
        }

        .btn-action.delete:hover {
            color: #EF4444;
            border-color: #EF4444;
        }

    .id-column {
        width: 10%;
        color: #94A3B8 !important;
        font-family: monospace;
        font-size: 1rem;
    }
</style>

<div class="container py-5">

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold mb-0 text-white">Categories Management</h2>
            <!-- تعديل لون النص الفرعي ليصبح واضحاً بدلاً من text-muted الافتراضي -->
            <p class="mt-1 mb-0 small" style="color: #94A3B8;">Manage and organize your product categories.</p>
        </div>
        <a asp-action="Create" class="btn btn-gold rounded-pill px-4 py-2 shadow-sm fw-semibold">
            + Add Category
        </a>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="surface-card text-center py-5">
            <h4 class="fw-light mb-0" style="color: #E2E8F0;">No categories found.</h4>
            <p class="small mt-2" style="color: #94A3B8;">Click "Add Category" to create your first one.</p>
        </div>
    }
    else
    {
        <!-- Table Wrapper -->
        <div class="surface-card">
            <div class="table-responsive">
                <table class="table table-borderless custom-table">

                    <thead>
                        <tr>
                            <th class="id-column">ID</th>
                            <th>Category Name</th>
                            <th class="text-end" style="width: 20%;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td class="id-column">#@category.Id</td>

                                <td class="fw-semibold">
                                    @category.Name
                                </td>

                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@category.Id"
                                           class="btn btn-action edit"
                                           title="Edit">
                                            &#x270E; Edit
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@category.Id"
                                              method="post"
                                              class="m-0 d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-action delete"
                                                    onclick="return confirm('Are you sure you want to delete this category?')"
                                                    title="Delete">
                                                &#x1F5D1; Delete
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }
</div>