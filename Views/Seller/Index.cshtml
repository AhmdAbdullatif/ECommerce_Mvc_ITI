@{
    ViewData["Title"] = "لوحة تحكم البائع";
}

<div class="container py-5" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">
            <i class="bi bi-speedometer2 text-primary me-2"></i> لوحة تحكم البائع
        </h2>
        <a href="#" class="btn btn-primary px-4 rounded-3 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i> إضافة منتج جديد
        </a>
    </div>

    <!-- البطاقات الإحصائية -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 fw-bold">إجمالي المنتجات</h6>
                        <h3 class="fw-bolder mb-0">0</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 me-3">
                        <i class="bi bi-currency-dollar fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 fw-bold">إجمالي المبيعات</h6>
                        <h3 class="fw-bolder mb-0">$0.00</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 me-3">
                        <i class="bi bi-star-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 fw-bold">التقييم العام</h6>
                        <h3 class="fw-bolder mb-0">0.0 / 5</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- مساحة للمنتجات لاحقاً -->
    <div class="text-center bg-white p-5 rounded-4 shadow-sm border-0 mt-4">
        <div class="mb-3">
            <i class="bi bi-shop text-muted" style="font-size: 4rem;"></i>
        </div>
        <h4 class="fw-bold text-dark">متجرك جاهز للعمل!</h4>
        <p class="text-muted fs-5">قم بإضافة منتجك الأول الآن لتبدأ في استقبال الطلبات.</p>
    </div>
</div>