@model ECommerce_Mvc.View_Model.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <div class="login-container">

        <!-- ================= LEFT SIDE ================= -->
        <div class="login-info">

            <div class="brand">
                <div class="brand-icon">
                    <i class="bi bi-bag-check-fill"></i>
                </div>

                <span>TeatId Store</span>
            </div>

            <div class="info-content">

                <span class="welcome-badge">
                    <i class="bi bi-stars"></i>
                    Welcome Back
                </span>

                <h1>
                    Shop Smarter.<br />
                    Live Better.
                </h1>

                <p>
                    Sign in to access your account, manage your orders,
                    discover new products and enjoy a seamless shopping
                    experience.
                </p>

                <div class="features">

                    <div class="feature">

                        <div class="feature-icon">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>

                        <div>
                            <h6>Fast & Easy Shopping</h6>
                            <span>
                                Browse thousands of products with ease.
                            </span>
                        </div>

                    </div>


                    <div class="feature">

                        <div class="feature-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>
                            <h6>Secure & Protected</h6>
                            <span>
                                Your account and information are always protected.
                            </span>
                        </div>

                    </div>


                    <div class="feature">

                        <div class="feature-icon">
                            <i class="bi bi-box-seam"></i>
                        </div>

                        <div>
                            <h6>Track Your Orders</h6>
                            <span>
                                Manage and track all your orders in one place.
                            </span>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= RIGHT SIDE ================= -->
        <div class="login-form-container">

            <div class="form-header">

                <div class="login-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <h2>Welcome Back!</h2>

                <p>
                    Login to your account to continue.
                </p>

            </div>


            <form asp-action="Login"
                  method="post"
                  class="login-form">

                <!-- Validation -->
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- Email -->
                <div class="input-group-custom">

                    <label asp-for="Email">
                        Email Address
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-envelope"></i>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter your email address"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="Email"
                          class="field-validation">
                    </span>

                </div>


                <!-- Password -->
                <div class="input-group-custom">

                    <div class="password-header">

                        <label asp-for="Password">
                            Password
                        </label>

                        <a href="#">
                            Forgot Password?
                        </a>

                    </div>


                    <div class="input-wrapper">

                        <i class="bi bi-lock"></i>

                        <input asp-for="Password"
                               type="password"
                               class="form-control password-input"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword()">

                            <i class="bi bi-eye"
                               id="passwordIcon">
                            </i>

                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="field-validation">
                    </span>

                </div>


                <!-- Remember Me -->
                <div class="login-options">

                    <div class="remember-me">

                        <input asp-for="RememberMe"
                               class="remember-checkbox" />

                        <label asp-for="RememberMe">
                            Remember me
                        </label>

                    </div>

                </div>


                <!-- Login Button -->
                <button type="submit"
                        class="login-btn">

                    <span>Login to Account</span>

                    <i class="bi bi-arrow-right"></i>

                </button>


                <!-- Divider -->
                <div class="divider">

                    <span>OR</span>

                </div>


                <!-- Register -->
                <div class="register-link">

                    <span>
                        Don't have an account?
                    </span>

                    <a asp-controller="Account"
                       asp-action="Register">

                        Create Account

                        <i class="bi bi-arrow-up-right"></i>

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


<script>

    function togglePassword() {

        const password =
            document.querySelector(".password-input");

        const icon =
            document.getElementById("passwordIcon");

        if (password.type === "password") {

            password.type = "text";

            icon.classList.remove("bi-eye");

            icon.classList.add("bi-eye-slash");

        }
        else {

            password.type = "password";

            icon.classList.remove("bi-eye-slash");

            icon.classList.add("bi-eye");

        }

    }

</script>


<style>

    /* ========================================
               LOGIN PAGE
            ======================================== */

    .login-page {
        min-height: calc(100vh - 70px);
        background: #f5f7fb;
        padding: 50px 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }


    /* ========================================
               CONTAINER
            ======================================== */

    .login-container {
        width: 100%;
        max-width: 1050px;
        min-height: 620px;
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        display: grid;
        grid-template-columns: 42% 58%;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
    }


    /* ========================================
               LEFT SIDE
            ======================================== */

    .login-info {
        background: linear-gradient( 145deg, #111827, #1f2937 );
        color: white;
        padding: 45px;
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }


        .login-info::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(245, 158, 11, 0.08);
            right: -130px;
            top: -100px;
        }


        .login-info::after {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
            left: -130px;
            bottom: -100px;
        }


    /* ========================================
               BRAND
            ======================================== */

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 22px;
        font-weight: 700;
        position: relative;
        z-index: 2;
    }


    .brand-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #f59e0b;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #111827;
    }


    /* ========================================
               LEFT CONTENT
            ======================================== */

    .info-content {
        margin-top: 85px;
        position: relative;
        z-index: 2;
    }


    .welcome-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(245,158,11,0.12);
        color: #fbbf24;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 18px;
    }


    .info-content h1 {
        font-size: 38px;
        line-height: 1.2;
        font-weight: 700;
        margin-bottom: 18px;
    }


    .info-content > p {
        color: #cbd5e1;
        font-size: 14px;
        line-height: 1.8;
        max-width: 380px;
    }


    /* ========================================
               FEATURES
            ======================================== */

    .features {
        margin-top: 38px;
        display: flex;
        flex-direction: column;
        gap: 22px;
    }


    .feature {
        display: flex;
        gap: 14px;
        align-items: flex-start;
    }


    .feature-icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: rgba(245,158,11,0.13);
        color: #f59e0b;
        display: flex;
        align-items: center;
        justify-content: center;
    }


    .feature h6 {
        margin: 0 0 4px;
        font-size: 13px;
        color: #f8fafc;
    }


    .feature span {
        color: #94a3b8;
        font-size: 11px;
        line-height: 1.5;
    }


    /* ========================================
               FORM CONTAINER
            ======================================== */

    .login-form-container {
        padding: 50px 65px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }


    /* ========================================
               HEADER
            ======================================== */

    .form-header {
        margin-bottom: 32px;
    }


    .login-icon {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        background: #fff7ed;
        color: #f59e0b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        margin-bottom: 15px;
    }


    .form-header h2 {
        color: #111827;
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 7px;
    }


    .form-header p {
        color: #6b7280;
        font-size: 13px;
        margin: 0;
    }


    /* ========================================
               INPUTS
            ======================================== */

    .input-group-custom {
        margin-bottom: 21px;
    }


        .input-group-custom label {
            display: block;
            margin-bottom: 7px;
            font-size: 13px;
            font-weight: 600;
            color: #374151;
        }


    .input-wrapper {
        position: relative;
    }


        .input-wrapper > i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            z-index: 2;
        }


        .input-wrapper .form-control {
            height: 50px;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding-left: 43px;
            padding-right: 45px;
            font-size: 13px;
            color: #111827;
            transition: all 0.2s ease;
        }


            .input-wrapper .form-control::placeholder {
                color: #9ca3af;
            }


            .input-wrapper .form-control:focus {
                border-color: #f59e0b;
                box-shadow: 0 0 0 3px rgba(245,158,11,0.12);
            }


    /* ========================================
               PASSWORD
            ======================================== */

    .password-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }


        .password-header a {
            font-size: 11px;
            color: #f59e0b;
            text-decoration: none;
            font-weight: 600;
        }


    .password-toggle {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #9ca3af;
        cursor: pointer;
        z-index: 3;
    }


        .password-toggle:hover {
            color: #f59e0b;
        }


    /* ========================================
               VALIDATION
            ======================================== */

    .field-validation {
        display: block;
        color: #dc2626;
        font-size: 11px;
        margin-top: 5px;
    }


    .validation-summary {
        color: #dc2626;
        font-size: 12px;
        margin-bottom: 15px;
    }


    /* ========================================
               REMEMBER ME
            ======================================== */

    .login-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }


    .remember-me {
        display: flex;
        align-items: center;
        gap: 8px;
    }


    .remember-checkbox {
        width: 15px;
        height: 15px;
        accent-color: #f59e0b;
        cursor: pointer;
    }


    .remember-me label {
        margin: 0;
        color: #6b7280;
        font-size: 12px;
        cursor: pointer;
    }


    /* ========================================
               LOGIN BUTTON
            ======================================== */

    .login-btn {
        width: 100%;
        height: 51px;
        border: none;
        border-radius: 10px;
        background: #f59e0b;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
    }


        .login-btn:hover {
            background: #d97706;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(245,158,11,0.25);
        }


        .login-btn i {
            transition: transform 0.2s ease;
        }


        .login-btn:hover i {
            transform: translateX(4px);
        }


    /* ========================================
               DIVIDER
            ======================================== */

    .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 27px 0;
        color: #9ca3af;
        font-size: 10px;
        font-weight: 600;
    }


        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #e5e7eb;
        }


    /* ========================================
               REGISTER
            ======================================== */

    .register-link {
        text-align: center;
        font-size: 12px;
        color: #6b7280;
    }


        .register-link a {
            color: #f59e0b;
            text-decoration: none;
            font-weight: 700;
            margin-left: 5px;
        }


            .register-link a:hover {
                color: #d97706;
            }


    /* ========================================
               RESPONSIVE
            ======================================== */

    @@media (max-width: 850px) {

        .login-container {
            grid-template-columns: 1fr;
        }

        .login-info {
            display: none;
        }

        .login-form-container {
            padding: 45px 35px;
        }
    }


    @@media (max-width: 576px) {

        .login-page {
            padding: 20px 10px;
        }

        .login-container {
            border-radius: 14px;
        }

        .login-form-container {
            padding: 35px 22px;
        }

        .form-header h2 {
            font-size: 26px;
        }
    }

</style>