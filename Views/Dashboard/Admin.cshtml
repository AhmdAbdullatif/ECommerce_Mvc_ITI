@model ECommerce_Mvc.ViewModels.AdminDashboardVM

<h1>Admin Dashboard</h1>

<div class="row">

    <div class="col-md-3">
        <div class="card p-3">
            <h5>Total Customers</h5>
            <h2>@Model.TotalCustomers</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <h5>Total Sellers</h5>
            <h2>@Model.TotalSellers</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <h5>Total Products</h5>
            <h2>@Model.TotalProducts</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <h5>Total Orders</h5>
            <h2>@Model.TotalOrders</h2>
        </div>
    </div>

</div>

<div class="row mt-4">

    <div class="col-md-3">
        <div class="card p-3">
            <h5>Pending Orders</h5>
            <h2>Not Available Yet</h2>
        </div>
    </div>

</div>