@model IEnumerable<ECommerce_Mvc.Models.Product>

@using System.Security.Claims
@using ECommerce_Mvc.Constants

@{
    ViewData["Title"] = "Products";

    string? currentUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Products</h2>

        @if (User.IsInRole(AuthorizationConstants.SELLERS))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                Add Product
            </a>
        }
    </div>

    <form asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <div class="col-md-4">
            <input type="text"
                   name="searchText"
                   value="@ViewBag.SearchText"
                   class="form-control"
                   placeholder="Search by product name" />
        </div>

        <div class="col-md-3">
            <select name="categoryId"
                    asp-items="ViewBag.Categories"
                    class="form-select">

                <option value="">
                    All Categories
                </option>
            </select>
        </div>

        <div class="col-md-3">
            <select name="sortOrder"
                    class="form-select">

                <option value="">
                    Sort By
                </option>

                <option value="price_asc"
                        selected="@(ViewBag.SortOrder == "price_asc")">
                    Price: Low to High
                </option>

                <option value="price_desc"
                        selected="@(ViewBag.SortOrder == "price_desc")">
                    Price: High to Low
                </option>
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit"
                    class="btn btn-success w-100">
                Search
            </button>
        </div>

        <div class="col-12">
            <a asp-action="Index"
               class="btn btn-secondary">
                Reset
            </a>
        </div>

    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No products found.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var product in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(product.PictureUri))
                        {
                            <img src="@product.PictureUri"
                                 class="card-img-top"
                                 style="height: 220px; object-fit: cover;"
                                 alt="@product.Name" />
                        }

                        <div class="card-body">

                            <h5 class="card-title">
                                @product.Name
                            </h5>

                            <p class="card-text">
                                @product.Description
                            </p>

                            <p>
                                <strong>Price:</strong>
                                @product.Price.ToString("0.00")
                            </p>

                            <p>
                                <strong>Quantity:</strong>
                                @product.Quantity
                            </p>

                            <p>
                                <strong>Category:</strong>
                                @(product.Category?.Name ?? "N/A")
                            </p>

                        </div>

                        <div class="card-footer">

                            <a asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-info btn-sm">
                                Details
                            </a>

                            @if (User.IsInRole(AuthorizationConstants.SELLERS)
                                && currentUserId == product.UserId)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@product.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@product.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('Are you sure you want to delete this product?')">
                                        Delete
                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>